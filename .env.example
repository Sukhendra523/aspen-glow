# Supabase Public Client Configuration
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER put service_role keys, database passwords, or privileged secrets in REACT_APP_* variables.
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-public-anon-key

